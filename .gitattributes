# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Explicit text types used by Godot sources
*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.gdp text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.exr binary
*.svg text
*.glb binary
*.gltf text
*.fbx binary
*.obj text
*.ttf binary
